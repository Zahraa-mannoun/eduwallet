{
  "name": "eduwallet",
  "version": "1.0.0",
  "description": "Student digital wallet platform for Lebanon's banking crisis",
  "private": true,
  "workspaces": [
    "backend",
    "mobile",
    "web",
    "web/edumart",
    "web/agent",
    "web/ocr-shop",
    "packages/shared"
  ],
  "scripts": {
    "backend": "cd backend && npm run dev",
    "mobile": "cd mobile && npm start",
    "web": "cd web && npm start",
    "edumart": "cd web/edumart && npm start",
    "agent": "cd web/agent && npm start",
    "ocr-shop": "cd web/ocr-shop && npm start"
  }
}