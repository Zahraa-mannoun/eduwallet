# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:8081,http://localhost:3001,http://localhost:3002

# Database (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eduwallet?schema=public"

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# Redis (sessions, refresh tokens, rate limiting)
REDIS_URL=redis://localhost:6379

# --- Not wired up yet (later phases) ---
# 2FA (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Document storage (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=eduwallet-documents
